<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bing.tpa.mapper.TpaSubjectMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.bing.tpa.domain.entity.TpaSubject">
        <id column="ts_id" property="tsId" />
        <result column="subject_name" property="subjectName" />
        <result column="subject_info" property="subjectInfo" />
        <result column="subject_stage" property="subjectStage" />
        <result column="customize" property="customize" />
        <result column="subtitle" property="subtitle" />
        <result column="volume" property="volume" />
        <result column="grade" property="grade" />
        <result column="subcode" property="subcode" />
        <result column="is_open" property="isOpen" />
        <result column="purpose" property="purpose" />
        <result column="school_id" property="schoolId" />
    </resultMap>
    <select id="findBySchoolId" resultType="com.bing.tpa.domain.entity.TpaSubject">
        SELECT * FROM tpa_subject
        WHERE school_id = #{schoolId}
    </select>

</mapper>
