<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bing.tpa.mapper.TpaHomeworkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.bing.tpa.domain.entity.TpaHomework">
        <id column="hid" property="hid" />
        <result column="cid" property="cid" />
        <result column="h_title" property="hTitle" />
        <result column="secondary_title" property="secondaryTitle" />
        <result column="explanation" property="explanation" />
        <result column="score" property="score" />
        <result column="complate" property="complate" />
        <result column="uncomplate" property="uncomplate" />
        <result column="quantity" property="quantity" />
        <result column="create_time" property="createTime" />
        <result column="deadline" property="deadline" />
        <result column="state" property="state" />
        <result column="problem_type" property="problemType" />
        <result column="is_open" property="isOpen" />
        <result column="h_type" property="hType" />
        <result column="author_id" property="authorId" />
    </resultMap>
    <update id="updateCompleteNum">
        UPDATE tpa_homework
        SET complate=complate+1 ,uncomplate=uncomplate-1
        WHERE hid= #{hid}
    </update>

    <select id="selectSubjectByHid" resultType="java.lang.String">
        SELECT tt.teach_lesson
        FROM tpa_homework th
        LEFT JOIN tpa_teacher tt ON th.author_id = tt.uid
        WHERE th.hid = #{hid}
    </select>
    <select id="selectByAuthorIdAndTitle" resultType="com.bing.tpa.domain.entity.TpaHomework">
        SELECT *
        FROM tpa_homework
        WHERE author_id = #{uid}
          AND (
            (h_title = #{title})
                OR (secondary_title = #{title})
            )
        order by create_time
    </select>

</mapper>
